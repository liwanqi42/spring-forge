    <version>2.0.0</version>
    <name>spring-forge</name>
    <description>全自动代码生成引擎 — 支持 MVC/DDD 双模式，基于 MyBatis-Plus</description>
    <url>https://github.com/liwanqi42/spring-forge</url>

