{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spring-Forge 代码生成配置",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "groupId", "basePackage", "mode"],
      "properties": {
        "name": { "type": "string", "description": "Maven artifactId" },
        "groupId": { "type": "string", "description": "Maven groupId" },
        "basePackage": { "type": "string", "description": "Java 基础包名" },
        "mode": { "type": "string", "enum": ["MVC", "DDD"], "description": "生成模式" },
        "outputDir": { "type": "string", "default": "." },
        "author": { "type": "string", "default": "CodeGenerator" },
        "overwrite": { "type": "boolean", "default": false }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "jdbcUrl": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "columns"],
        "properties": {
          "name": { "type": "string", "description": "表名" },
          "comment": { "type": "string", "description": "表注释" },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "javaType": { "type": "string" },
                "length": { "type": "integer" },
                "nullable": { "type": "boolean" },
                "primaryKey": { "type": "boolean" },
                "autoIncrement": { "type": "boolean" },
                "comment": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "generateDdl": { "type": "boolean", "default": false },
        "logicDeleteField": { "type": "string", "default": "deleted" },
        "optimisticLockField": { "type": "string", "default": "version" },
        "idType": { "type": "string", "default": "ASSIGN_ID" },
        "tablePrefix": { "type": "string", "default": "" },
        "useLombok": { "type": "boolean", "default": true }
      }
    }
  }
}
